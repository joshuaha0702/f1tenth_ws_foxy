<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="params_file" default="$(find racecar_description)/config/params.yaml" />
  <xacro:property name="config" value="${xacro.load_yaml('$(arg params_file)')}" />
  <xacro:macro name="racecar_gazebo" params="namespace">
    <!-- Chassis physics -->
    <gazebo reference="chassis">
      <mu1 value="0.0"/>
      <mu2 value="0.0"/>
      <kp value="10000000.0" />
      <kd value="1.0" />
      <minDepth>0.001</minDepth>
      <material>Gazebo/Blue</material>
    </gazebo>

    <!-- Wheels physics -->
    <gazebo reference="left_rear_wheel"><mu1 value="1.0"/><mu2 value="1.0"/><material>Gazebo/Black</material></gazebo>
    <gazebo reference="right_rear_wheel"><mu1 value="1.0"/><mu2 value="1.0"/><material>Gazebo/Black</material></gazebo>
    <gazebo reference="left_front_wheel"><mu1 value="1.0"/><mu2 value="1.0"/><material>Gazebo/Black</material></gazebo>
    <gazebo reference="right_front_wheel"><mu1 value="1.0"/><mu2 value="1.0"/><material>Gazebo/Black</material></gazebo>

    <!-- Ackermann Drive Plugin -->
    <gazebo>
      <plugin name="gazebo_ros_ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
        <ros>
          <namespace>${namespace}</namespace>
          <remapping>cmd_vel:=drive</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>1000.0</update_rate>
        <front_left_joint>left_front_wheel_joint</front_left_joint>
        <front_right_joint>right_front_wheel_joint</front_right_joint>
        <rear_left_joint>left_rear_wheel_joint</rear_left_joint>
        <rear_right_joint>right_rear_wheel_joint</rear_right_joint>
        <left_steering_joint>left_steering_hinge_joint</left_steering_joint>
        <right_steering_joint>right_steering_hinge_joint</right_steering_joint>
        
        
        <wheel_separation>0.2</wheel_separation>
        <wheel_diameter>0.1</wheel_diameter>
        <wheelbase>0.325</wheelbase>
        <max_wheel_torque>5000</max_wheel_torque>
        
        <max_speed>10.0</max_speed>
        <max_steer>0.5236</max_steer>
        <max_steering_angle_velocity>5.0</max_steering_angle_velocity>

        <!-- ★ 클로드 수정본: ROS 2 플러그인용 올바른 PID 파라미터 이름 -->
        <linear_velocity_pid_gain>1.0 0.0 0.0</linear_velocity_pid_gain>
        <left_steering_pid_gain>2.0 0.0 0.0</left_steering_pid_gain>
        <right_steering_pid_gain>2.0 0.0 0.0</right_steering_pid_gain>
        
        <max_wheel_steering_angle>0.5236</max_wheel_steering_angle>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        
        <!-- namespace split -->
        <odometry_frame>${namespace}/odom</odometry_frame>
        <robot_base_frame>${namespace}/base_link</robot_base_frame>
      </plugin>
    </gazebo>

    <!-- Joint State Publisher Plugin -->
    <gazebo>
      <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <namespace>${namespace}</namespace>
        </ros>
        <update_rate>30</update_rate>
        <joint_name>left_rear_wheel_joint</joint_name>
        <joint_name>right_rear_wheel_joint</joint_name>
        <joint_name>left_front_wheel_joint</joint_name>
        <joint_name>right_front_wheel_joint</joint_name>
        <joint_name>left_steering_hinge_joint</joint_name>
        <joint_name>right_steering_hinge_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- Laser Scanner Plugin -->
    <gazebo reference="laser">
      <sensor type="ray" name="hokuyo_sensor">
        <visualize>true</visualize>
        <update_rate>200</update_rate>
        <ray>
          <scan><horizontal><samples>1081</samples><min_angle>-2.356</min_angle><max_angle>2.356</max_angle></horizontal></scan>
          <range><min>0.1</min><max>10.0</max></range>
        </ray>
        <plugin name="gazebo_ros_hokuyo_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>${namespace}</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${namespace}/laser</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>